{
    "manifest_version": 2,
    "version": "1.0.0",
    "name": "Aerofoil: Liquid Glass theme for Firefox",
    "short_name": "Aerofoil",
    "author": "Vantalter",
    "description": "A Firefox theme inspired by the refined Liquid Glass design of macOS 27.",
    "homepage_url": "https://github.com/vantalter/aerofoil",
    "icons": {
        "32": "img/icon_x32.png",
        "64": "img/icon_x64.png",
        "128": "img/icon_x128.png",
        "256": "img/icon_x256.png"
    },
    "theme": {
        "images": {
            "additional_backgrounds": [
                "img/light_frame_right.svg",
                "img/light_frame_left.svg",
                "img/light_frame_center.svg"
            ]
        },
        "properties": {
            "additional_backgrounds_alignment": [
                "right top",
                "left top",
                "center top"
            ],
            "additional_backgrounds_tiling": [
                "no-repeat",
                "no-repeat",
                "repeat-x"
            ],
            "color_scheme": "light",
            "content_color_scheme": "system"
        },
        "colors": {
            "frame": "rgb(233, 233, 236)",
            "frame_inactive": "rgb(242, 242, 244)",
            "toolbar": "rgba(232, 232, 235, 0.96)",
            "toolbar_field": "rgba(255, 255, 255, 0.78)",
            "toolbar_field_border": "rgba(255, 255, 255, 0.86)",
            "toolbar_text": "rgb(44, 44, 48)",
            "toolbar_field_text": "rgb(32, 32, 36)",
            "toolbar_field_focus": "rgba(255, 255, 255, 0.94)",
            "toolbar_field_border_focus": "rgb(10, 132, 255)",
            "toolbar_field_text_focus": "rgb(24, 24, 28)",
            "toolbar_field_highlight": "rgb(10, 132, 255)",
            "toolbar_field_highlight_text": "rgb(255, 255, 255)",
            "toolbar_top_separator": "rgba(255, 255, 255, 0.52)",
            "toolbar_bottom_separator": "rgba(84, 84, 88, 0.22)",
            "toolbar_vertical_separator": "rgba(84, 84, 88, 0.18)",
            "icons": "rgb(61, 61, 66)",
            "icons_attention": "rgb(10, 132, 255)",
            "bookmark_text": "rgb(44, 44, 48)",
            "tab_selected": "rgba(255, 255, 255, 0.62)",
            "tab_text": "rgb(35, 35, 39)",
            "tab_line": "rgba(255, 255, 255, 0)",
            "tab_loading": "rgb(10, 132, 255)",
            "tab_background_text": "rgb(71, 71, 76)",
            "tab_background_text_inactive": "rgb(130, 130, 136)",
            "sidebar": "rgba(242, 242, 247, 0.92)",
            "sidebar_text": "rgb(35, 35, 39)",
            "sidebar_border": "rgba(84, 84, 88, 0.2)",
            "sidebar_highlight": "rgb(10, 132, 255)",
            "sidebar_highlight_text": "rgb(255, 255, 255)",
            "popup": "rgba(246, 246, 248, 0.94)",
            "popup_text": "rgb(35, 35, 39)",
            "popup_highlight": "rgb(10, 132, 255)",
            "popup_highlight_text": "rgb(255, 255, 255)",
            "popup_border": "rgba(84, 84, 88, 0.34)",
            "button_background_hover": "rgba(120, 120, 128, 0.16)",
