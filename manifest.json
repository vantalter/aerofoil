            "popup_highlight": "rgb(10, 132, 255)",
            "popup_highlight_text": "rgb(255, 255, 255)",
            "popup_border": "rgba(255, 255, 255, 0.2)",
            "button_background_hover": "rgba(255, 255, 255, 0.12)",
            "button_background_active": "rgba(255, 255, 255, 0.2)",
            "ntp_background": "rgb(28, 28, 30)",
            "ntp_card_background": "rgb(44, 44, 46)",
            "ntp_text": "rgb(245, 245, 247)"
        }
    }
}
