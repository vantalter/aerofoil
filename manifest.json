            "ntp_card_background": "rgb(255, 255, 255)",
            "ntp_text": "rgb(28, 28, 30)"
        }
    },
    "dark_theme": {
         "images": {
            "additional_backgrounds": [
                "img/dark_frame_right.svg",
                "img/dark_frame_left.svg",
                "img/dark_frame_center.svg"
            ]
        },
        "properties": {
            "additional_backgrounds_alignment": [
                "right top",
                "left top",
                "center top"
            ],
            "additional_backgrounds_tiling": [
                "no-repeat",
                "no-repeat",
                "repeat-x"
            ],
            "color_scheme": "dark",
            "content_color_scheme": "system"
        },
        "colors": {
